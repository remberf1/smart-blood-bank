# Server
PORT=5000

# Database
MONGODB_URI=mongodb://localhost:27017/smart-blood-bank

# Auth
JWT_SECRET=replace-with-a-long-random-string

# CORS: comma-separated list of allowed frontend origins
FRONTEND_ORIGINS=http://localhost:3000

# Twilio (WhatsApp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# Set to false ONLY for local testing without a public webhook URL
TWILIO_VALIDATE=true
# Outbound notifications (request status, donor eligibility, appointment reminders).
# Auto-disabled if Twilio creds are missing; set to false to force-disable.
NOTIFICATIONS_ENABLED=true
# If behind ngrok/a proxy, set the exact public webhook URL Twilio calls
# TWILIO_WEBHOOK_URL=https://your-domain/api/whatsapp/webhook

# One-time super-admin seed (used by scripts/seedAdmin.js)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Super Admin
