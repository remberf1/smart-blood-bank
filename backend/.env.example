# Server
PORT=5000

# Database
MONGODB_URI=mongodb://localhost:27017/smart-blood-bank

# Auth
JWT_SECRET=replace-with-a-long-random-string

# CORS: comma-separated list of allowed frontend origins
FRONTEND_ORIGINS=http://localhost:3000

# Twilio (WhatsApp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# Set to false ONLY for local testing without a public webhook URL
TWILIO_VALIDATE=true
# Outbound WhatsApp notifications (request status, donor eligibility, reminders).
# Auto-disabled if Twilio creds are missing; set to false to force-disable.
NOTIFICATIONS_ENABLED=true

# Email notifications (SMTP via nodemailer). Auto-disabled if SMTP creds are
# missing; set EMAIL_ENABLED=false to force-disable. Works with Gmail app
# passwords or providers like SendGrid/Mailgun/Zoho/Resend/SES.
EMAIL_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# IMPORTANT: for deliverability the From domain MUST be one you can publish DNS
# for (see DELIVERABILITY below). Relaying Gmail while From is a different domain
# = SPF/DKIM/DMARC fail = Spam. Prefer From @your-verified-domain.
SMTP_FROM="Smart Blood Bank <no-reply@example.com>"
# Optional: where replies go when From is a no-reply address.
SMTP_REPLY_TO=
# Optional: unsubscribe target (mailto: or https:). When set, emails carry
# List-Unsubscribe (+ one-click for https) — required for bulk senders and a
# positive deliverability signal. e.g. mailto:unsubscribe@your-domain
SMTP_LIST_UNSUBSCRIBE=
# Public app URL used in email links (welcome, status, track, appointments).
# Set to your real frontend origin in production so CTA buttons work.
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# DELIVERABILITY (why mail lands in Spam, and how to fix it)
# ---------------------------------------------------------------------------
# The "message isn't authenticated" warning + Spam = your From domain lacks
# aligned SPF/DKIM/DMARC. Fix ONE of these two ways:
#
# TESTING WITHOUT A DOMAIN — Mailtrap Email Sandbox (no DNS, never hits real inboxes):
#   Great for previewing templates + a spam-score report. Sign up at mailtrap.io,
#   open Email Testing > your Inbox > SMTP Settings, and paste its creds here:
#     SMTP_HOST=sandbox.smtp.mailtrap.io
#     SMTP_PORT=2525
#     SMTP_USER=<from Mailtrap inbox>
#     SMTP_PASS=<from Mailtrap inbox>
#     SMTP_FROM="Smart Blood Bank <no-reply@smartbloodbank.test>"
#   Then: node scripts/test-email.js anything@example.com status
#   The email appears in your Mailtrap inbox (not a real inbox). No code change.
#
# RECOMMENDED (real delivery) — transactional provider (Resend / SendGrid / Mailgun / SES / Postmark):
#   1. Sign up, add & VERIFY your domain in their dashboard.
#   2. Add the DNS records they give you (SPF include + DKIM CNAME/TXT).
#   3. Add a DMARC record:  _dmarc.your-domain  TXT
#        v=DMARC1; p=none; rua=mailto:dmarc@your-domain
#   4. Set SMTP_HOST/PORT/USER/PASS to the provider's SMTP creds and
#      SMTP_FROM to an address @your-verified-domain. Done — no code change.
#
# SELF-HOSTED domain send (no provider) — then also DKIM-sign here:
#   1. SPF   TXT on your-domain:   v=spf1 ip4:<your-sending-ip> -all
#   2. Generate a DKIM keypair, publish the public key at
#        <selector>._domainkey.your-domain  TXT  (v=DKIM1; k=rsa; p=<pubkey>)
#      and set the three DKIM_* vars below (private key, \n-escaped on one line).
#   3. DMARC as above.
# Leave DKIM_* unset when your provider/relay already signs (Gmail, SendGrid…).
DKIM_DOMAIN=
DKIM_SELECTOR=
DKIM_PRIVATE_KEY=
# If behind ngrok/a proxy, set the exact public webhook URL Twilio calls
# TWILIO_WEBHOOK_URL=https://your-domain/api/whatsapp/webhook

# One-time super-admin seed (used by scripts/seedAdmin.js)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Super Admin

# XGBoost demand-prediction service (ml-service/). When set, the forecast API
# calls it and falls back to the in-process heuristic if it's unavailable.
ML_SERVICE_URL=http://127.0.0.1:8100
ML_TIMEOUT_MS=4000
